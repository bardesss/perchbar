{
  "$schema": "https://perchbar.dev/schema/widget.schema.json",
  "id": "world-clock",
  "name": "World Clock",
  "description": "The time in one or more cities, rotating between them.",
  "author": "Perchbar",
  "version": "1.0.0",
  "formatVersion": 1,
  "refresh": 10,
  "settings": [
    {
      "key": "cities",
      "label": "Cities (Label|Time zone)",
      "kind": "list",
      "default": ["Amsterdam|Europe/Amsterdam", "Tokyo|Asia/Tokyo"]
    },
    {
      "key": "rotate",
      "label": "Seconds per city",
      "kind": "number",
      "default": 6
    }
  ]
}
