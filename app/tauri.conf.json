{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perchbar",
  "version": "0.1.0",
  "identifier": "dev.perchbar.app",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": {
      "script": "npm --prefix ../ui ci && npm --prefix ../ui run build",
      "cwd": "."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Perchbar",
    "shortDescription": "Live widgets on your Windows 11 taskbar",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
